# ChartBreaker environment configuration.
# Copy this file to .env and fill in real values. .env is gitignored.

# ---- Target deployment ----
# The dedicated ChartBreaker test user (NOT admin) with patients:demo ACL
# and access to the fixture-patient set defined in chartbreaker/config.py.
CHARTBREAKER_TARGET_USER=changeme
CHARTBREAKER_TARGET_PASSWORD=changeme

# ---- LLM providers (per chartbreaker/config.py MODEL_REGISTRY) ----
OPENAI_API_KEY=sk-...
OPENROUTER_API_KEY=sk-or-...

# ---- Optional providers (set only if MODEL_REGISTRY is repointed to them) ----
# ANTHROPIC_API_KEY=sk-ant-...
# Ollama: no auth required; assumes http://localhost:11434/v1

# ---- Optional observability ----
# LANGCHAIN_API_KEY=ls__...
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_PROJECT=chartbreaker
